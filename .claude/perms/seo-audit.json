      "Bash(sh:*)",
      "Bash(zsh:*)",
      "Bash(xargs:*)",
      "Bash(python3:*)",
      "Bash(eval:*)",
      "Read(**/.env*)",
      "Read(config/**/*credential*)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(//proc/**)",
      "Read(//root/**)",
      "Read(//etc/**)",
      "Read(//home/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Bash(*--attach*)",
      "Bash(*>*)",
      "Read(mail/**)",
      "Read(belege/**)",
      "Read(rechnungen/**)",
      "Read(logs/**)",
      "Read(config/server.json)",
      "Read(config/backups.json)",
      "Read(.env)"
    ]
  }
}
