      "Bash(service:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(crontab:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(dnf:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(socat:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(telnet:*)",
      "Bash(ftp:*)",
      "Bash(rsync:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(perl:*)",
      "Bash(ruby:*)",
      "Bash(php:*)",
      "Edit(//etc/**)",
      "Write(//etc/**)",
      "Edit(//root/**)",
      "Write(//root/**)",
      "Write(//usr/**)",
      "Bash(awk:*)",
      "Bash(gawk:*)",
      "Bash(mawk:*)",
      "Bash(sed:*)",
      "Bash(curl:*)",
      "Bash(env:*)",
